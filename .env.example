# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed.
#
# Two kinds of variables live here:
#   * VITE_*  — PUBLIC config. Vite inlines these into the client bundle, so
#               they are visible to anyone. Never put a secret behind a VITE_ prefix.
#   * others  — SERVER-ONLY config read by the BFF proxy (server.js / the Vite
#               dev proxy in vite.config.ts). These stay in Node and are never
#               shipped to the browser. Admin tokens go here.
#
# docker-compose.yml injects the same values when running in Docker.

# --- Public config (safe to expose to the browser) --------------------------
VITE_API_URL=https://verifierapi.openid4vc.staging.yivi.app
VITE_VERAMO_ISSUER_API_URL=https://veramo-issuer.openid4vc.staging.yivi.app
VITE_IRMA_SERVER_URL=https://is.demo.staging.yivi.app
VITE_UNIVERSAL_LINK_HOST=open.yivi.app

# --- Server-only config (used by the BFF proxy, never sent to the browser) ---
VERAMO_API_URL=https://veramo-verifier.openid4vc.staging.yivi.app
VERAMO_VERIFIER_NAME=test-verifier
VERAMO_ISSUER_API_URL=https://veramo-issuer.openid4vc.staging.yivi.app
VERAMO_ISSUER_NAME=test-issuer
VERAMO_AUTHCODE_ISSUER_NAME=authcode-issuer

# Admin tokens — REQUIRED, no default. Obtain from a maintainer; do not commit.
# NOTE: no VITE_ prefix — these must never reach the browser.
VERAMO_ADMIN_TOKEN=your-veramo-verifier-admin-token
VERAMO_ISSUER_ADMIN_TOKEN=your-veramo-issuer-admin-token
