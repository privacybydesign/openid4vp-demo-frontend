# Store text files with LF in the repository, check them out with CRLF
* text=auto eol=crlf

# Shell scripts run inside Linux containers and must keep LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
